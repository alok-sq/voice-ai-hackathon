# Copy to .env and fill in. Never commit .env, and never paste these into Slack, WhatsApp or code.
# This file is a template: keep every value below a placeholder.

# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Name the agent worker registers under (must match the agent's WorkerOptions.agent_name)
AGENT_NAME=solarsquare-lrm

# Telephony (SIP trunk registered in LiveKit). Only needed for phone calls.
SIP_OUTBOUND_TRUNK_ID=
# Comma-separated E.164 numbers the console may dial. Team and test numbers only.
TEST_NUMBER_ALLOWLIST=

# Browser origins allowed to call this backend
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Agent worker vendors. STT = Sarvam, LLM = Google Gemini, TTS = Cartesia Sonic.
STT_API_KEY=
LLM_API_KEY=
TTS_API_KEY=

# Optional model settings (defaults shown)
# STT_MODEL=saaras:v4
# STT_MODE=codemix
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_MAX_TOKENS=200
# TTS_MODEL=sonic-3
# S2S_MODEL=gemini-3.8-live            # Demo v2 speech-to-speech (Gemini Live)
# S2S_VOICE=                   # Gemini Live voice id (empty = Puck if VOICE_GENDER=male, else Kore)
# CARTESIA_VOICE_ID=            # a Hindi-capable voice id from your Cartesia account
# CARTESIA_AGENT_ID=            # Demo v3: agent id from the Cartesia dashboard. That agent's prompt answers the call.
# CARTESIA_FROM_NUMBER_ID=      # Demo v3 phone calls: the Cartesia phone number id the agent dials from.
# ELEVENLABS_API_KEY=           # Demo v4: ElevenLabs API key. Stays on the server; the browser only gets a signed url.
# ELEVENLABS_AGENT_ID=          # Demo v4: agent id from the ElevenLabs dashboard. That agent's prompt answers the call.
# ELEVENLABS_PHONE_NUMBER_ID=   # Demo v4 phone calls: the ElevenLabs phone number id the agent dials from.
# VOICE_GENDER=male             # grammar Ajay uses about himself: male or female
# MIN_ENDPOINTING_DELAY=0.4     # seconds of quiet before the agent replies
# SILENCE_TIMEOUT_S=10          # seconds of silence before a re-prompt
# OUT_DIR=out                   # where the per-call JSON record is written

# Cost rates in INR for the per-call cost estimate (0 until you fill them in)
# COST_LLM_IN_PER_MTOK=0
# COST_LLM_OUT_PER_MTOK=0
# COST_STT_PER_HOUR=0
# COST_TTS_PER_1K_CHARS=0
